<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Warehouse" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lavender</item>
        <item name="colorPrimaryVariant">@color/lavender_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sky</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Warehouse.NoActionBar" parent="Theme.Warehouse" />

    <style name="ButtonPill" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="TextInputOutlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/lavender</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="CardSurface" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Input dạng pill bo tròn toàn phần, nền xám nhạt, không viền: dùng cho Login/Register -->
    <style name="TextInputPill" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_fill</item>
        <item name="boxCornerRadiusTopStart">26dp</item>
        <item name="boxCornerRadiusTopEnd">26dp</item>
        <item name="boxCornerRadiusBottomStart">26dp</item>
        <item name="boxCornerRadiusBottomEnd">26dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="ButtonPillNavy" parent="ButtonPill">
        <item name="backgroundTint">@color/navy</item>
    </style>
</resources>
